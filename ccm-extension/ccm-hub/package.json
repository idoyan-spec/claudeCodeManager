{
  "name": "hub",
  "displayName": "Claude Code Manager Hub",
  "description": "One-click: open a Claude Code session as a new terminal in the current VS Code window.",
  "version": "0.0.10",
  "publisher": "ccm",
  "engines": { "vscode": "^1.60.0" },
  "categories": ["Other"],
  "activationEvents": ["onUri", "onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ccmHub.newSession",
        "title": "ccm: New Claude session in a terminal"
      },
      {
        "command": "ccmHub.openProjectPicker",
        "title": "ccm: Open project (recent first)"
      },
      {
        "command": "ccmHub.closeSession",
        "title": "ccm: Close terminal (backup / close / keep)"
      },
      {
        "command": "ccmHub.copyTerminalSelection",
        "title": "ccm: Copy terminal selection (explain probe)"
      },
      {
        "command": "ccmHub.exportMarkdownPdf",
        "title": "ccm: Export Markdown to PDF (RTL)",
        "category": "ccm",
        "icon": "$(file-pdf)"
      }
    ],
    "keybindings": [
      {
        "command": "ccmHub.openProjectPicker",
        "key": "alt+o"
      },
      {
        "command": "ccmHub.closeSession",
        "key": "alt+q"
      },
      {
        "command": "ccmHub.copyTerminalSelection",
        "key": "ctrl+alt+insert",
        "when": "terminalFocus"
      }
    ],
    "menus": {
      "terminal/title/context": [
        {
          "command": "ccmHub.closeSession",
          "group": "navigation@1"
        }
      ],
      "terminal/context": [
        {
          "command": "ccmHub.closeSession",
          "group": "navigation@1"
        }
      ],
      "editor/title": [
        {
          "command": "ccmHub.exportMarkdownPdf",
          "when": "resourceLangId == markdown",
          "group": "navigation@9"
        }
      ],
      "editor/title/context": [
        {
          "command": "ccmHub.exportMarkdownPdf",
          "when": "resourceLangId == markdown",
          "group": "1_ccm"
        }
      ],
      "explorer/context": [
        {
          "command": "ccmHub.exportMarkdownPdf",
          "when": "resourceLangId == markdown",
          "group": "1_ccm"
        }
      ]
    },
    "configuration": {
      "title": "Claude Code Manager Hub",
      "properties": {
        "ccmHub.projectsRoot": {
          "type": "string",
          "default": "E:\\MAIN_CLAUDE",
          "markdownDescription": "Folder whose immediate subdirectories are listed by the `Alt+O` project picker."
        },
        "ccmHub.claudeCommand": {
          "type": "string",
          "default": "claude --dangerously-skip-permissions",
          "markdownDescription": "Command run in the new terminal after it is opened in the chosen folder."
        },
        "ccmHub.guardTerminalClose": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Protect terminals from being closed by accident. Sets `#terminal.integrated.confirmOnKill#` to `always` (one terminal) and `#terminal.integrated.confirmOnExit#` to `always` (the whole window's X) — each only if you have not set it yourself — and offers to restore a Claude session you killed. `Alt+Q` asks *backup / close / keep* regardless of this setting."
        }
      }
    }
  }
}
